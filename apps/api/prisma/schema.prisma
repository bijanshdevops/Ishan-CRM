generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  ACTIVE
  DISABLED

  @@map("user_status")
}

enum TeamRole {
  MEMBER
  LEAD

  @@map("team_role")
}

enum CustomerKind {
  PERSON
  ORGANIZATION

  @@map("customer_kind")
}

/// Tenant root. Single-tenant deployment today; every domain table carries organization_id.
model Organization {
  id        String    @id @default(uuid(7)) @db.Uuid
  name      String
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  roles     Role[]
  users     User[]
  teams     Team[]
  auditLogs AuditLog[]
  customers Customer[]
  contacts  Contact[]
  tags      Tag[]

  @@map("organizations")
}

/// Permissions are a closed catalog defined in code (@ishan/contracts); a role stores the granted keys.
model Role {
  id             String   @id @default(uuid(7)) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  key            String
  name           String
  description    String?
  isSystem       Boolean  @default(false) @map("is_system")
  permissions    String[]
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id])
  users        User[]

  @@unique([organizationId, key])
  @@map("roles")
}

model User {
  id                 String     @id @default(uuid(7)) @db.Uuid
  organizationId     String     @map("organization_id") @db.Uuid
  roleId             String     @map("role_id") @db.Uuid
  email              String
  name               String
  passwordHash       String     @map("password_hash")
  status             UserStatus @default(ACTIVE)
  mustChangePassword Boolean    @default(false) @map("must_change_password")
  mfaEnabled         Boolean    @default(false) @map("mfa_enabled")
  /// AES-256-GCM encrypted TOTP secret (base64 iv.tag.ciphertext)
  mfaSecretEnc       String?    @map("mfa_secret_enc")
  failedLoginCount   Int        @default(0) @map("failed_login_count")
  lockedUntil        DateTime?  @map("locked_until") @db.Timestamptz(6)
  lastLoginAt        DateTime?  @map("last_login_at") @db.Timestamptz(6)
  createdAt          DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt          DateTime?  @map("deleted_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id])
  role         Role         @relation(fields: [roleId], references: [id])
  sessions     Session[]
  memberships  TeamMember[]
  ownedCustomers Customer[]

  @@unique([organizationId, email])
  @@index([roleId])
  @@map("users")
}

model Session {
  id         String    @id @default(uuid(7)) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  /// SHA-256 of the opaque cookie token; the raw token is never stored.
  tokenHash  String    @unique @map("token_hash")
  ip         String?
  userAgent  String?   @map("user_agent")
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  lastSeenAt DateTime  @default(now()) @map("last_seen_at") @db.Timestamptz(6)
  /// Idle expiry (sliding).
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(6)
  /// Absolute expiry (never extended).
  absoluteExpiresAt DateTime @map("absolute_expires_at") @db.Timestamptz(6)
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model Team {
  id             String    @id @default(uuid(7)) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  name           String
  description    String?
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id])
  members      TeamMember[]

  @@unique([organizationId, name])
  @@map("teams")
}

model TeamMember {
  teamId    String   @map("team_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  role      TeamRole @default(MEMBER)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([teamId, userId])
  @@index([userId])
  @@map("team_members")
}

/// Append-only: a database trigger rejects UPDATE and DELETE (see migration).
model AuditLog {
  id             String   @id @default(uuid(7)) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  /// Intentionally not a foreign key so the log survives user deletion untouched.
  actorId        String?  @map("actor_id") @db.Uuid
  action         String
  entityType     String   @map("entity_type")
  entityId       String?  @map("entity_id")
  metadata       Json?
  ip             String?
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId, createdAt(sort: Desc)])
  @@index([entityType, entityId])
  @@map("audit_logs")
}

model Customer {
  id             String       @id @default(uuid(7)) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  kind           CustomerKind
  name           String
  nationalId     String?      @map("national_id")
  economicCode   String?      @map("economic_code")
  email          String?
  phone          String?
  website        String?
  province       String?
  city           String?
  address        String?
  notes          String?
  ownerId        String?      @map("owner_id") @db.Uuid
  createdById    String?      @map("created_by_id") @db.Uuid
  /// Normalized (Persian letters/digits unified, lowercased) text used by search.
  searchText     String       @default("") @map("search_text")
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt      DateTime?    @map("deleted_at") @db.Timestamptz(6)

  organization Organization  @relation(fields: [organizationId], references: [id])
  owner        User?         @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  contacts     Contact[]
  tags         CustomerTag[]

  @@index([organizationId, id(sort: Desc)])
  @@index([organizationId, kind])
  @@index([ownerId])
  @@index([organizationId, email])
  @@map("customers")
}

model Contact {
  id             String    @id @default(uuid(7)) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  customerId     String?   @map("customer_id") @db.Uuid
  firstName      String    @map("first_name")
  lastName       String    @map("last_name")
  jobTitle       String?   @map("job_title")
  email          String?
  phone          String?
  mobile         String?
  isPrimary      Boolean   @default(false) @map("is_primary")
  notes          String?
  searchText     String    @default("") @map("search_text")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id])
  customer     Customer?    @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@index([organizationId, id(sort: Desc)])
  @@map("contacts")
}

model Tag {
  id             String   @id @default(uuid(7)) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  name           String
  color          String   @default("#6366f1")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization  @relation(fields: [organizationId], references: [id])
  customers    CustomerTag[]

  @@unique([organizationId, name])
  @@map("tags")
}

model CustomerTag {
  customerId String @map("customer_id") @db.Uuid
  tagId      String @map("tag_id") @db.Uuid

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  tag      Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([customerId, tagId])
  @@index([tagId])
  @@map("customer_tags")
}

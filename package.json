{
  "name": "ishan-crm",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:migrate": "pnpm --filter @ishan/api exec prisma migrate deploy",
    "db:migrate:dev": "pnpm --filter @ishan/api exec prisma migrate dev",
    "db:generate": "pnpm --filter @ishan/api exec prisma generate"
  },
  "devDependencies": {
    "prettier": "3.6.2",
    "turbo": "2.5.8",
    "typescript": "5.9.3"
  },
  "pnpm": {
    "overrides": {
      "fastify": "5.12.7"
    }
  }
}
